---
import MainLayout from '../layouts/MainLayout.astro';
import { SctrBreakdown } from '../components/coberturas/SctrBreakdown';
import { InsurersMatrix } from '../components/coberturas/InsurersMatrix';
import { VidaLeyCard } from '../components/coberturas/VidaLeyCard';
import CoberturasForm from '../components/coberturas/CoberturasForm';
---

<MainLayout>
  <app-coberturas>
    <header class="hero-mini">
      <div class="container">
        <span class="eyebrow eyebrow--light">Coberturas &amp; SCTR</span>
        <h1>Coberturas obligatorias y emisión express para tu operación</h1>
        <p>
          Conoce qué cubre cada seguro obligatorio y asegura que tus trabajadores del DS.009-97-TR ingresen sin
          contratiempos a obra y garitas.
        </p>
      </div>
    </header>

    <section class="section">
      <div class="container">
        <span class="eyebrow">Normativa SCTR</span>
        <h2 class="section-title">SCTR Salud y SCTR Pensión: coberturas diferenciadas</h2>
        <p class="lead">
          El Seguro Complementario de Trabajo de Riesgo es obligatorio para las actividades de alto riesgo calificadas
          por el Ministerio de Trabajo (DS.009-97-TR): minería, construcción, electricidad, gas y otras actividades
          conforme a la norma.
        </p>
        <SctrBreakdown />
      </div>
    </section>

    <section class="section">
      <div class="container">
        <span class="eyebrow">Matriz comparativa</span>
        <h2 class="section-title">Aseguradoras multimarca respaldadas</h2>
        <InsurersMatrix />
      </div>
    </section>

    <section class="section">
      <div class="container coberturas__vida">
        <div>
          <span class="eyebrow">Seguro obligatorio adicional</span>
          <h2 class="section-title">Seguro Vida Ley para toda la planilla</h2>
          <p class="lead">
            Requerido a todas las empresas con personal en planilla, sin importar el nivel de riesgo del puesto ni la
            actividad económica del negocio.
          </p>
        </div>
        <VidaLeyCard />
      </div>
    </section>

    <section class="section comparison-cta" id="comparativo">
      <div class="container coberturas__cta">
        <div class="coberturas__form">
          <h2>Solicita tu comparativo de tasas</h2>
          <p>Registramos tu planilla y contacto: enviamos el comparativo multimarca por correo.</p>
          <CoberturasForm client:load />
        </div>
      </div>
    </section>
  </app-coberturas>
</MainLayout>
